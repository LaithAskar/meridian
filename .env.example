# Copy to .env and fill in your own values. Never commit .env.
# Robinhood credentials (used by backend + crypto_bot)
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
# Note: this repo's auth code does not read an MFA env var. The first
# login on a new machine prompts interactively for an MFA code; after
# that, robin_stocks caches the session (store_session=True).

# Trading mode. Set to "true" to disable real order execution. Default to true until you have audited the bot end-to-end.
TRADING_PAPER_MODE=true

# Frontend → backend URL (public, OK to commit a default)
NEXT_PUBLIC_API_URL=http://localhost:8000

# FinBERT inference device: "cpu" or "cuda"
FINBERT_DEVICE=cpu
